{
  "name": "aria",
  "displayName": "Aria",
  "description": "AI-powered commit message generation",
  "version": "0.6.2",
  "author": "Vortex",
  "publisher": "Vortex",
  "icon": "resources/aria.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realloon/Aria.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "vscode": "^1.92.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "tsc --noEmit && node esbuild.ts",
    "compile:production": "tsc --noEmit && node esbuild.ts --production",
    "vscode:prepublish": "pnpm run compile:production",
    "build": "env -u npm_config_npm_globalconfig -u npm_config_verify_deps_before_run -u npm_config__jsr_registry node ./node_modules/@vscode/vsce/vsce package --no-dependencies"
  },
  "dependencies": {
    "openai": "^6.37.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/vscode": "1.92.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.api.provider": {
          "type": "string",
          "enum": [
            "deepseek",
            "openai",
            "openai-compatible"
          ],
          "default": "deepseek",
          "description": "Model provider used by Aria."
        },
        "aria.api.apiKeys.deepseek": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key used by Aria."
        },
        "aria.api.apiKeys.openai": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key used by Aria."
        },
        "aria.api.apiKeys.openai-compatible": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API key used by Aria."
        },
        "aria.api.baseURLs.openai-compatible": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL used by Aria."
        },
        "aria.api.reasoningEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "high",
          "description": "Reasoning effort sent to the commit-message model."
        }
      }
    },
    "commands": [
      {
        "command": "aria.generateCommitMessage",
        "title": "Aria: Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aria.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ]
    }
  }
}
