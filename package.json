{
  "name": "aria-vscode-extension",
  "displayName": "Aria",
  "description": "Programming agent extension scaffold for Aria.",
  "version": "0.6.0",
  "publisher": "Vortex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realloon/Aria.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "vscode": "^1.92.0"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile:production",
    "compile": "tsc --noEmit && vite build --config src/webview/vite.config.ts && node esbuild.ts",
    "compile:production": "tsc --noEmit && vite build --config src/webview/vite.config.ts && node esbuild.ts --production",
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "check-types": "tsc --noEmit",
    "build": "env -u npm_config_npm_globalconfig -u npm_config_verify_deps_before_run -u npm_config__jsr_registry node ./node_modules/@vscode/vsce/vsce package --no-dependencies"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "2.0.0-alpha.2",
    "markdown-it": "^14.1.1",
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "1.92.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.10",
    "vue": "^3.5.33"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.api.provider": {
          "type": "string",
          "enum": [
            "deepseek",
            "openai",
            "openai-compatible"
          ],
          "default": "deepseek",
          "description": "Model provider used by Aria."
        },
        "aria.api.apiKeys.deepseek": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key used by Aria."
        },
        "aria.api.apiKeys.openai": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key used by Aria."
        },
        "aria.api.apiKeys.openai-compatible": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API key used by Aria."
        },
        "aria.api.baseURLs.openai-compatible": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL used by Aria."
        },
        "aria.api.reasoningEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "high",
          "description": "Reasoning effort sent to the chat model."
        },
        "aria.fim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable FIM inline completions in the editor."
        },
        "aria.fim.maxTokens": {
          "type": "number",
          "default": 128,
          "minimum": 64,
          "maximum": 4096,
          "description": "Maximum tokens generated for one FIM completion."
        }
      }
    },
    "commands": [
      {
        "command": "aria.newThread",
        "title": "Aria: New Thread",
        "icon": "$(add)"
      },
      {
        "command": "aria.showHistory",
        "title": "Aria: History",
        "icon": "$(history)"
      },
      {
        "command": "aria.deleteThread",
        "title": "Aria: Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "aria.showSystemPrompt",
        "title": "Aria: Show System Prompt"
      },
      {
        "command": "aria.showFimContext",
        "title": "Aria: Show FIM Context"
      },
      {
        "command": "aria.generateCommitMessage",
        "title": "Aria: Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.inlineSuggest.trigger",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aria.newThread",
          "when": "view == aria.chatView",
          "group": "navigation@1"
        },
        {
          "command": "aria.deleteThread",
          "when": "view == aria.chatView",
          "group": "navigation@2"
        },
        {
          "command": "aria.showHistory",
          "when": "view == aria.chatView",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "aria.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aria",
          "title": "Aria",
          "icon": "resources/aria.svg"
        }
      ]
    },
    "views": {
      "aria": [
        {
          "id": "aria.chatView",
          "name": "Chat",
          "icon": "resources/aria.svg",
          "type": "webview"
        }
      ]
    }
  }
}
