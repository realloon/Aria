{
  "name": "aria",
  "displayName": "Aria",
  "description": "AI-powered commit message generation",
  "version": "0.8.0",
  "author": "Vortex",
  "publisher": "Vortex",
  "icon": "resources/aria.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realloon/Aria.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "vscode": "^1.92.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "tsc --noEmit && node esbuild.ts",
    "compile:production": "tsc --noEmit && node esbuild.ts --production",
    "vscode:prepublish": "pnpm run compile:production",
    "build": "env -u npm_config_npm_globalconfig -u npm_config_verify_deps_before_run -u npm_config__jsr_registry node ./node_modules/@vscode/vsce/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.92.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.api.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key used by Aria."
        }
      }
    },
    "commands": [
      {
        "command": "aria.generateCommitMessage",
        "title": "Aria: Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aria.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ]
    }
  }
}
