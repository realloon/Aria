{
  "name": "aria-vscode-extension",
  "displayName": "Aria",
  "description": "Programming agent extension scaffold for Aria.",
  "version": "0.1.0",
  "publisher": "aria",
  "type": "module",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "vscode": "^1.92.0"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc --noEmit && vite build --config src/webview/vite.config.ts && node esbuild.ts",
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "watch": "node esbuild.ts --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "markdown-it": "^14.1.1",
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "1.92.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.10",
    "vue": "^3.5.33"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.api.provider": {
          "type": "string",
          "enum": [
            "deepseek",
            "openai"
          ],
          "default": "deepseek",
          "description": "Model provider used by Aria."
        },
        "aria.api.apiKeys.deepseek": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key used by Aria."
        },
        "aria.api.apiKeys.openai": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key used by Aria."
        },
        "aria.api.reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "high",
          "description": "Reasoning effort sent to the chat model."
        },
        "aria.fim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable FIM inline completions in the editor."
        },
        "aria.fim.maxTokens": {
          "type": "number",
          "default": 128,
          "minimum": 1,
          "maximum": 4096,
          "description": "Maximum tokens generated for one FIM completion."
        },
        "aria.fim.useWorkspaceSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Include compact VS Code workspace symbol matches in FIM prompts when available."
        }
      }
    },
    "commands": [
      {
        "command": "aria.openSettings",
        "title": "Aria: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aria.showSystemPrompt",
        "title": "Aria: Show System Prompt"
      },
      {
        "command": "aria.showFimContext",
        "title": "Aria: Show FIM Context"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.inlineSuggest.trigger",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aria.openSettings",
          "when": "view == aria.chatView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aria",
          "title": "Aria",
          "icon": "resources/aria.svg"
        }
      ]
    },
    "views": {
      "aria": [
        {
          "id": "aria.chatView",
          "name": "Chat",
          "icon": "resources/aria.svg",
          "type": "webview"
        }
      ]
    }
  }
}
