{
  "name": "aria-vscode-extension",
  "displayName": "Aria",
  "description": "Programming agent extension scaffold for Aria.",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "vscode": "^1.92.0"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc --noEmit && vite build --config src/webview/vite.config.ts && node esbuild.ts",
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "watch": "node esbuild.ts --watch",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "1.92.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.10",
    "vue": "^3.5.33"
  },
  "dependencies": {
    "markdown-it": "^14.1.1",
    "openai": "^6.35.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.api.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for an OpenAI-compatible model API."
        },
        "aria.api.model": {
          "type": "string",
          "default": "",
          "description": "Model name used by the Aria chat panel."
        },
        "aria.api.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key used by Aria for model requests."
        }
      }
    },
    "commands": [
      {
        "command": "aria.openSettings",
        "title": "Aria: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aria.showSystemPrompt",
        "title": "Aria: Show System Prompt"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aria.openSettings",
          "when": "view == aria.chatView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aria",
          "title": "Aria",
          "icon": "resources/aria.svg"
        }
      ]
    },
    "views": {
      "aria": [
        {
          "id": "aria.chatView",
          "name": "Chat",
          "icon": "resources/aria.svg",
          "type": "webview"
        }
      ]
    }
  }
}
