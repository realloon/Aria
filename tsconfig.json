{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vscode"],
    "skipLibCheck": true
  },
  "include": [
    "src/extension",
    "src/webview/src",
    "src/webview/vite.config.ts",
    "esbuild.ts"
  ]
}
