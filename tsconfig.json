{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vscode"],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/", "esbuild.ts"]
}
